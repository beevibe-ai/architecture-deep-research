{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ADR Studio",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "studio: build",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/studio"],
      "outFiles": ["${workspaceFolder}/studio/out/**/*.js"]
    }
  ]
}
