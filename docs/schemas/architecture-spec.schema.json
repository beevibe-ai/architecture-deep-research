{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/architecture-deep-research/schemas/architecture-spec.schema.json",
  "title": "Beevibe Architecture Deep Research Architecture Spec",
  "type": "object",
  "required": ["version", "decision", "domain_model", "candidate_topologies", "guardrails"],
  "properties": {
    "version": {
      "type": "string"
    },
    "decision": {
      "type": "object",
      "required": ["id", "title", "status", "selected_topology", "summary"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "approved", "superseded", "rejected"]
        },
        "mode": {
          "type": "string",
          "enum": ["ranked_options", "deferred"],
          "description": "How to read this decision. \"ranked_options\" — the option space is mapped; the reader picks. recommendation is always null. \"deferred\" — no candidate cleared the promotion gate."
        },
        "ranked_options": {
          "type": "array",
          "description": "The primary output of ADR: a ranked option set with tradeoffs. Every viable candidate from the comparison matrix appears here.",
          "items": {
            "type": "object",
            "required": ["name", "label"],
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "summary": { "type": "string" },
              "when_to_pick": {
                "type": "array",
                "items": { "type": "string" }
              },
              "when_not_to_pick": {
                "type": "array",
                "items": { "type": "string" }
              },
              "strong_axes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "weak_axes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "risks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "required_invariants": {
                "type": "array",
                "items": { "type": "string" }
              },
              "forbidden_topologies": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence_citations": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 }
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": true
          }
        },
        "recommendation": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "why"],
              "properties": {
                "name": { "type": "string" },
                "why": { "type": "string" },
                "when_this_breaks": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "selected_topology": {
          "type": "string",
          "description": "Back-compat shortcut. When mode=recommended, equals recommendation.name. When mode=ranked_options, equals the literal string \"ranked_options\". When mode=deferred, equals \"requires_human_architecture_review\". Prefer reading mode + ranked_options + recommendation directly."
        },
        "summary": { "type": "string" },
        "evidence_citations": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": true
    },
    "domain_model": {
      "type": "object",
      "required": ["bounded_contexts", "core_entities", "domain_invariants"],
      "properties": {
        "bounded_contexts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "core_entities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domain_invariants": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "candidate_topologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fit", "risks", "decision"],
        "properties": {
          "name": { "type": "string" },
          "fit": { "type": "string" },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "decision": {
            "type": "string",
            "enum": ["selected", "considered", "rejected", "deferred"],
            "description": "selected = the recommendation; considered = viable option carrying tradeoffs but not the recommendation; rejected = filtered out by promotion gate or relevance filter; deferred = ADR could not place it (used when mode=deferred)."
          }
        },
        "additionalProperties": true
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["forbidden_topologies", "required_invariants"],
      "properties": {
        "forbidden_topologies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_invariants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_agentic_use": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url", "relevance"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" },
          "relevance": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
