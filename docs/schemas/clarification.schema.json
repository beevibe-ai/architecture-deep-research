{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/architecture-deep-research/schemas/clarification.schema.json",
  "title": "Beevibe Architecture Deep Research Clarification",
  "type": "object",
  "required": ["version", "needs_clarification", "questions", "action"],
  "properties": {
    "version": { "type": "string" },
    "needs_clarification": { "type": "boolean" },
    "questions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    },
    "suggested_profiles": {
      "type": "array",
      "description": "Pre-built answer profiles that match the discover-stage signals. The user can pick one via --clarification-profile <id> instead of answering free-form questions.",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "action": { "type": "string" }
  },
  "additionalProperties": true
}
