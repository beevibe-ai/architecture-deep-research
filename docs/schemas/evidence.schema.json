{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/architecture-deep-research/schemas/evidence.schema.json",
  "title": "Beevibe Architecture Deep Research Evidence Items",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "citation_id",
      "task_id",
      "title",
      "url",
      "query",
      "excerpt",
      "source_quality",
      "score",
      "relevance"
    ],
    "properties": {
      "citation_id": { "type": "integer", "minimum": 1 },
      "task_id": { "type": "string" },
      "title": { "type": "string" },
      "url": { "type": "string" },
      "query": { "type": "string" },
      "excerpt": { "type": "string" },
      "provider": { "type": "string" },
      "source_type": { "type": "string" },
      "source_quality": { "type": "number", "minimum": 0, "maximum": 1 },
      "keyword_hits": {
        "type": "array",
        "items": { "type": "string" }
      },
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["claim", "architecture_family", "polarity", "confidence"],
          "properties": {
            "claim": { "type": "string" },
            "architecture_family": { "type": "string" },
            "polarity": { "type": "string" },
            "domain_conditions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "risk_or_fit": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": true
        }
      },
      "score": { "type": "number", "minimum": 0 },
      "relevance": { "type": "string" }
    },
    "additionalProperties": true
  }
}
