{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/beevibe-cto/schemas/execution-handoff.schema.json",
  "title": "Architecture Deep Research — Execution Handoff",
  "description": "Generated on-demand by `adr handoff <out_dir> --option <candidate-name>`. Scopes the research-report's chosen candidate into an implementation contract for a downstream coding agent or human operator.",
  "type": "object",
  "required": [
    "version",
    "decision_id",
    "handoff_boundary",
    "artifacts",
    "agent_targets"
  ],
  "properties": {
    "version": { "type": "string" },
    "decision_id": { "type": "string" },
    "handoff_boundary": {
      "type": "string",
      "enum": [
        "adr_stops_at_research_report",
        "adr_stops_at_execution_handoff"
      ],
      "description": "New value is `adr_stops_at_research_report`. The legacy `adr_stops_at_execution_handoff` is kept for backward compatibility with pre-0.3 example runs."
    },
    "chosen_option": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" }
      ],
      "description": "The candidate the operator chose via `adr handoff --option <name>`. Null when the handoff was generated across all candidates (no option-scoped contract yet)."
    },
    "options": {
      "type": "array",
      "description": "Per-option contract block. When chosen_option is set, this array has length 1.",
      "items": {
        "type": "object",
        "required": ["name", "label"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "evidence_depth": {
            "type": "string",
            "enum": ["thick", "medium", "thin"]
          },
          "when_to_pick": {
            "type": "array",
            "items": { "type": "string" }
          },
          "when_not_to_pick": {
            "type": "array",
            "items": { "type": "string" }
          },
          "strong_axes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "weak_axes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "citations": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["adr"],
      "properties": {
        "adr": { "type": "string" },
        "research_report": { "type": "string" },
        "research_report_markdown": { "type": "string" },
        "architecture_spec": { "type": "string" },
        "domain_evaluation_pack": { "type": "string" },
        "agent_guardrails": { "type": "string" },
        "sources": { "type": "string" }
      },
      "additionalProperties": true
    },
    "agent_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "feedback_contract": {
      "type": "object",
      "properties": {
        "expected_inputs_from_execution": {
          "type": "array",
          "items": { "type": "string" }
        },
        "may_trigger_superseding_adr": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
