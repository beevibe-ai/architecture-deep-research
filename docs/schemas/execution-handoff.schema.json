{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/architecture-deep-research/schemas/execution-handoff.schema.json",
  "title": "Beevibe Architecture Deep Research Execution Handoff",
  "description": "The handoff is per-option: a downstream coding agent or human operator picks one option from `options[]`, then honors that option's required_invariants and forbidden_topologies. `recommendation` names the option ADR favors when the evidence supports a clear winner; when `mode = ranked_options`, recommendation is null and the caller MUST pick. The top-level `required_invariants` and `forbidden_topologies` are back-compat fallbacks that mirror the recommended option (or are empty when there is no recommendation).",
  "type": "object",
  "required": [
    "version",
    "decision_id",
    "handoff_boundary",
    "artifacts",
    "agent_targets",
    "required_invariants",
    "forbidden_topologies"
  ],
  "properties": {
    "version": { "type": "string" },
    "decision_id": { "type": "string" },
    "handoff_boundary": {
      "type": "string",
      "const": "adr_stops_at_execution_handoff"
    },
    "mode": {
      "type": "string",
      "enum": ["recommended", "ranked_options", "deferred"]
    },
    "options": {
      "type": "array",
      "description": "Per-option contracts. The caller picks one option (or accepts the recommendation if present), then must honor that option's required_invariants and avoid its forbidden_topologies.",
      "items": {
        "type": "object",
        "required": ["name", "label"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "when_to_pick": {
            "type": "array",
            "items": { "type": "string" }
          },
          "when_not_to_pick": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_invariants": {
            "type": "array",
            "items": { "type": "string" }
          },
          "forbidden_topologies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_citations": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "recommendation": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name", "why"],
          "properties": {
            "name": { "type": "string" },
            "why": { "type": "string" },
            "when_this_breaks": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "required": [
        "adr",
        "architecture_spec",
        "domain_evaluation_pack",
        "agent_guardrails"
      ],
      "properties": {
        "adr": { "type": "string" },
        "architecture_spec": { "type": "string" },
        "domain_evaluation_pack": { "type": "string" },
        "agent_guardrails": { "type": "string" },
        "sources": { "type": "string" }
      },
      "additionalProperties": true
    },
    "agent_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_invariants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Back-compat: mirrors the recommended option's invariants when mode=recommended; empty when mode=ranked_options (caller must pick from options[]) or mode=deferred. New code should read options[] directly."
    },
    "forbidden_topologies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Back-compat: same shape as required_invariants."
    },
    "feedback_contract": {
      "type": "object",
      "properties": {
        "expected_inputs_from_execution": {
          "type": "array",
          "items": { "type": "string" }
        },
        "may_trigger_superseding_adr": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
