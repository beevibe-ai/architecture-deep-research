{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/beevibe-cto/schemas/principles.schema.json",
  "title": "Beevibe Team Principles",
  "description": "Repo-wide team principles discovered by `adr principles init` and confirmed via interactive interview. Consumed by `adr review` (PR-time check) and `adr guard` (write-time hook).",
  "type": "object",
  "required": ["version", "source", "lenses", "principles"],
  "properties": {
    "version": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["repo_path", "scanned_at"],
      "properties": {
        "repo_path": { "type": "string" },
        "scanned_at": { "type": "string" },
        "interview_completed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "product_intent": {
      "type": "object",
      "properties": {
        "identity": { "type": "string" },
        "architectural_intent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "why": { "type": "string" },
              "evidence_cite": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "product_philosophy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "statement": { "type": "string" },
              "evidence_cite": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement"],
            "properties": {
              "statement": { "type": "string" },
              "evidence_cite": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "rationale"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "rationale": { "type": "string" },
          "scan_signals": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lens", "polarity", "rule", "evidence_cite"],
        "properties": {
          "id": { "type": "string" },
          "lens": { "type": "string" },
          "polarity": {
            "type": "string",
            "enum": ["do", "dont"]
          },
          "rule": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence_cite": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "examples_to_follow": {
            "type": "array",
            "items": { "type": "string" }
          },
          "examples_to_avoid": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confirmed_by_interview": { "type": "boolean" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "additionalProperties": false
      }
    },
    "interview_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string" },
          "lens": { "type": "string" },
          "answer": { "type": "string" },
          "skipped": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
