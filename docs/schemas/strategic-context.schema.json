{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/architecture-deep-research/schemas/strategic-context.schema.json",
  "title": "Beevibe Architecture Deep Research Strategic Context Model",
  "type": "object",
  "required": [
    "version",
    "source",
    "domain",
    "decision",
    "domain_entities",
    "bounded_contexts",
    "query_shapes",
    "risk_invariants",
    "operational_envelope",
    "compliance_constraints"
  ],
  "properties": {
    "version": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["path", "content_hash"],
      "properties": {
        "path": { "type": "string" },
        "content_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "domain": { "type": "string" },
    "decision": { "type": "string" },
    "decision_kind": {
      "type": "string",
      "enum": ["family", "concrete"],
      "description": "family = picking an architecture pattern/topology; concrete = picking a specific product/vendor/library/service. Inferred from the decision name when not supplied explicitly."
    },
    "domain_entities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bounded_contexts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "query_shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "risk_invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operational_envelope": {
      "type": "object",
      "properties": {
        "latency": { "type": "string" },
        "cost": { "type": "string" },
        "scale": { "type": "string" },
        "availability": { "type": "string" }
      },
      "additionalProperties": true
    },
    "compliance_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_architecture_families": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acquisition_contract": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "no_static_pattern_oracle": { "type": "boolean" },
        "no_offline_research_mode": { "type": "boolean" },
        "candidate_architecture_families_source": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
