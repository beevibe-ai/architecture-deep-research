    "new_decision_id": { "type": "string" },
    "new_topology": { "type": "string" },
    "reason": { "type": "string" },
    "previous_artifact_dir": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
