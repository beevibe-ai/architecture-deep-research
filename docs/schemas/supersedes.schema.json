{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beevibe-ai/beevibe-cto/schemas/supersedes.schema.json",
  "title": "Beevibe Architecture Deep Research Supersession Record",
  "type": "object",
  "required": [
    "version",
    "previous_topology",
    "new_topology",
    "reason",
    "previous_artifact_dir",
    "created_at"
  ],
  "properties": {
    "version": { "type": "string" },
    "previous_decision_id": { "type": "string" },
