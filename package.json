{
  "name": "@beevibe/beevibe-cto",
  "version": "0.3.0",
  "description": "Beevibe AI CTO — the decision layer your coding agents are missing. Flagship feature: ADR (Architecture Deep Research). Coming next: adr drift, adr review, adr guard.",
  "license": "Apache-2.0",
  "author": "Beevibe",
  "homepage": "https://github.com/beevibe-ai/beevibe-cto",
  "repository": {
    "type": "git",
    "url": "https://github.com/beevibe-ai/beevibe-cto.git"
  },
  "keywords": [
    "beevibe",
    "ai-cto",
    "architecture",
    "beevibe-cto",
    "adr",
    "claude-code",
    "mcp",
    "coding-agent",
    "design-implement-drift",
    "pr-review",
    "antipatterns"
  ],
  "type": "module",
  "files": [
    "src",
    "scripts",
    "adapters",
    "docs/schemas",
    "plugin",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/kernel.mjs",
    "./adapters/langgraph": "./adapters/langgraph.mjs",
    "./adapters/langgraph-llm": "./adapters/langgraph-llm.mjs",
    "./adapters/google-adk": "./adapters/google-adk.mjs",
    "./adapters/google-adk-deep-research": "./adapters/google-adk-deep-research.mjs",
    "./adapters/beevibe": "./adapters/beevibe.mjs"
  },
  "bin": {
    "adr": "./scripts/adr.mjs",
    "adr-langgraph": "./scripts/adr-langgraph.mjs",
    "adr-adk": "./scripts/adr-adk.mjs",
    "adr-web": "./scripts/adr-web.mjs",
    "adr-mcp": "./scripts/adr-mcp.mjs",
    "adr-doctor": "./scripts/adr-doctor.mjs"
  },
  "scripts": {
    "adr": "node scripts/adr.mjs",
    "adr:langgraph": "node scripts/adr-langgraph.mjs",
    "adr:adk": "node scripts/adr-adk.mjs",
    "adr:web": "node scripts/adr-web.mjs",
    "adr:mcp": "node scripts/adr-mcp.mjs",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "crystal:dev": "vite --config crystal-ball/vite.config.js",
    "crystal:build": "vite build --config crystal-ball/vite.config.js",
    "crystal:server": "node crystal-ball/server.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:replay": "node scripts/kernel-regression-tests.mjs",
    "benchmark:live": "node scripts/benchmark.mjs --strict",
    "benchmark:live:fast": "node scripts/benchmark.mjs --config benchmarks/configs/live-fast.json --strict",
    "demo": "node scripts/demo.mjs",
    "deep-research": "node scripts/adr.mjs deep-research",
    "test:kernel": "node scripts/kernel-regression-tests.mjs",
    "test:search": "node scripts/search-provider-tests.mjs",
    "check": "node scripts/check-json.mjs",
    "smoke:frameworks": "node scripts/smoke-frameworks.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test": "npm run test:kernel && npm run test:search && npm run check && npm run smoke:frameworks && npm run smoke:web && npm run smoke:mcp"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@google/adk": "^1.1.0",
    "@langchain/langgraph": "^1.3.2",
    "langchain": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@google/adk": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/adk": "^1.1.0",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "langchain": "^1.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.16",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "ajv": "^8.20.0",
    "three": "^0.169.0"
  }
}
