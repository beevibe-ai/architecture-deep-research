{
  "name": "@beevibe/architecture-deep-research",
  "version": "0.1.0",
  "private": true,
  "description": "Deep research for strategic system design decisions.",
  "license": "Apache-2.0",
  "author": "Beevibe",
  "homepage": "https://github.com/beevibe-ai/architecture-deep-research",
  "repository": {
    "type": "git",
