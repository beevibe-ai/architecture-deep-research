{
  "name": "adr-studio",
  "displayName": "ADR Studio — Architecture Canvas",
  "description": "Drag-and-drop system architecture canvas with an AI design assistant. Designs compile to architecture.spec.json for coding agents.",
  "version": "0.1.0",
  "publisher": "beevibe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beevibe-ai/architecture-deep-research"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Other"],
  "main": "./out/extension.js",
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.2.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "adrStudio.open",
        "title": "Open Architecture Canvas",
        "category": "ADR Studio"
      },
      {
        "command": "adrStudio.setApiKey",
        "title": "Set Anthropic API Key",
        "category": "ADR Studio"
      }
    ],
    "configuration": {
      "title": "ADR Studio",
      "properties": {
        "adrStudio.specPath": {
          "type": "string",
          "default": ".adr/architecture.spec.json",
          "description": "Workspace-relative path to the architecture spec the canvas reads and writes."
        },
        "adrStudio.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Anthropic model the design assistant uses for topology edits."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config webview/vite.config.js",
    "build:host": "node esbuild.mjs",
    "build": "npm run build:webview && npm run build:host",
    "watch:host": "node esbuild.mjs --watch",
    "dev": "vite build --watch --config webview/vite.config.js",
    "package": "npm run build && vsce package",
    "test": "node --test shared/*.test.mjs host/*.test.mjs"
  }
}
